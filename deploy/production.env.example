# Copiar a production.env y completar allí. Nunca subir el archivo real.
# Usar --env-file deploy/production.env para interpolación de Compose.
STORE_HOST=tienda.example
CATALOG_IMAGE=catalog-boutique:local
STORE_SUBNET=172.30.10.0/24
PROXY_IP=172.30.10.2
HTTP_PORT=80
HTTPS_PORT=443
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=tienda.example;localhost
# SQL Server externo/administrado; usuario propio por negocio, no sa.
ConnectionStrings__DefaultConnection='Server=SQL_HOST,1433;Database=TIENDA_DB;User Id=TIENDA_USER;Password=REEMPLAZAR;Encrypt=True;TrustServerCertificate=False'
Jwt__Key=REEMPLAZAR
Jwt__Issuer=tienda.example
Jwt__Audience=tienda.example
DataProtection__KeysPath=/var/lib/catalog/keys
DataProtection__ApplicationName=Catalog.TiendaEjemplo
Seo__PublicUrl=https://tienda.example
Seo__AllowIndexing=false
Cors__Origins__0=https://tienda.example
Stripe__FrontendUrl=https://tienda.example
Stripe__SecretKey=
Stripe__WebhookSecret=
Postmark__Enabled=false
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Postmark__ServerToken=
Postmark__From=
Postmark__MessageStream=outbound
Email__FrontendUrl=https://tienda.example
Email__RequireConfirmedForCheckout=false
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
